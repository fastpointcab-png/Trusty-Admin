rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Admin Identification & Driver Rules)
    // =========================================================================
    function isAdmin() {
      // 1. Authenticated user with explicit super admin email or admin claims
      return (request.auth != null && (
        request.auth.token.email == '123mdcreation@gmail.com' ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      )) || 
      // 2. Direct Admin Console Access Token / Key check if passed in document request
      (request.resource != null && request.resource.data.admin_secret == 'cab_admin_secret_auth') ||
      // 3. Permissive admin access during development / trusted admin console sessions
      true;
    }

    // =========================================================================
    // 1. DRIVERS COLLECTION (Presence, Location, FCM Token, Status)
    // =========================================================================
    match /drivers/{driverId} {
      // Driver profile lookup, login check, presence, and admin dashboard monitoring
      allow read: if true;

      // Allow driver app to update presence, location, FCM token, device session,
      // and allow Admin Console to register/edit drivers
      allow create, update: if true;

      // Allow Admin Console to delete/remove driver records (prevents unauthorized client deletion)
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. TRIPS COLLECTION (Dispatch, Acceptance, Meter & Fares)
    // =========================================================================
    match /trips/{tripId} {
      // Allow reading open trips, assigned trips, and admin dispatch board
      allow read: if true;

      // Allow driver to accept trip, start with OTP, update status, complete ride,
      // and allow Admin Console to dispatch new trips, reassign, cancel, or edit
      allow create, update: if true;

      // Only Admin Console can delete cancelled or archived trips
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. SYSTEM SETTINGS (Single Master Killswitch & Fleet Dispatch Control)
    // =========================================================================
    match /system_settings/{docId} {
      // Drivers read backend killswitch, admin console updates dispatch control
      allow read, write: if true;
    }

    match /app_control/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. RATE CARDS & FARE CONFIGURATION
    // =========================================================================
    match /fare_rates/{rateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. ADMIN USERS & AUDIT LOGS
    // =========================================================================
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 6. OPTIONAL CUSTOMER TRACKING SESSIONS (Single-trip token lookup)
    // =========================================================================
    match /tracking_sessions/{token} {
      // Allow customers to read their session and dispatch/drivers to create/update/deactivate
      allow read, write: if true;
    }
  }
}
